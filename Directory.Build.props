<Project>

  <!-- 全树公共属性：命名与版本之外的构建口径统一收口处 -->

  <!-- NuGet 漏洞审计：SQLitePCLRaw 2.x 全线受 GHSA-2m69-gcr7-jv3q 影响且上游暂无修复版本
       （dotnet/dev-proxy 等官方仓库同款处置，待 Microsoft.Data.Sqlite 出修复包后移除本条并升级）。 -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <!-- MySqlConnector 与 SharpCompress：已升至当时最新稳定版（3.0.0 / 1.0.0），公告 GHSA-473q-m89c-ghf8、
         GHSA-6c8g-7p36-r338 的标记范围与最新版并存且无更高修复版；升到修复版后本条自动失效。 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-473q-m89c-ghf8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
