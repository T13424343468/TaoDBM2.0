    {
      "id": "S12",
      "feature": "SQL真实执行-计数",
      "action": "query",
      "sql": "SELECT COUNT(*) AS c FROM orders;",
      "expectContains": [
        "__ORDERS_COUNT__"
      ],
      "critical": true,
      "shot": "shot-08-count-5000.png"
    },
    {
      "id": "S13",
