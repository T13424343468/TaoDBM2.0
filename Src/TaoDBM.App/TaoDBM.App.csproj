<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TaoDBM</RootNamespace>
    <AssemblyName>TaoDBM</AssemblyName>
    <ApplicationIcon>Assets\TaoDBM.ico</ApplicationIcon>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- #216: export/import pickers moved to WinForms dialogs - WinUI FileSavePicker natively crashes on Windows Server sessions (walk runners 4/4 app-death); WinForms dialog is the classic #32770 both Server and client render -->
    <!-- #217 fix: UseWinForms is not a recognized property under Microsoft.NET.Sdk (WindowsDesktop-SDK only) - CS0234 'Forms' missing; reference the WinForms shared framework explicitly -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 保全口径补丁（2026-11-18 #78 云端定谳）：PublishTrimmed 会隐式关闭反射式 System.Text.Json
         （运行时报 Reflection-based serialization has been disabled），连接存盘等所有 JsonSerializer 调用在
         MSI 裁剪发布下必挂。TrimMode=partial 本就不裁应用元数据，显式恢复反射序列化器。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaoDBM.Core\TaoDBM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\TaoDBM.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TaoDBM.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 拍板（2026-11-28）：网页版手册随包——Scripts/gen_manual_html.py 与程序内手册同源生成，
         随发布产物进安装目录（MSI PublishComponents 按 $(PublishDir)\** 收齐），不装程序双击就能看 -->
    <Content Include="..\Docs\UserManual.html" Link="UserManual.html" CopyToOutputDirectory="PreserveNewest" />
    <None Update="App.manifest" />
  </ItemGroup>

</Project>
