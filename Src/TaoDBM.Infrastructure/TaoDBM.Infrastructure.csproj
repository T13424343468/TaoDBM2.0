<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaoDBM.Core.Abstractions\TaoDBM.Core.Abstractions.csproj" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.5.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- 全版本兼容矩阵（2026-11-19 13:08 老板令）：Oracle 11g 级老库专用 19c 系驱动（ODP.NET Core 19 线，100% 托管），
       随程序输出到 drivers/oracle19，由 OracleLegacyDriver 独立 AssemblyLoadContext 隔离加载，不与常驻 23.x 驱动冲突 -->
  <ItemGroup>
    <Content Include="drivers\oracle19\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
