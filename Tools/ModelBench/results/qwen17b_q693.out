WITH user_orders AS (
    SELECT 
        u.id,
        u.name,
        COUNT(o.id) AS order_count
    FROM users u
    JOIN orders o ON u.id = o.user_id
    GROUP BY u.id, u.name
)
SELECT 
    id, 
    name, 
    order_count,
    ROW_NUMBER() OVER (ORDER BY order_count DESC) AS rank
FROM user_orders;

