你是一个数据库助手。根据表结构和问题，写出 MySQL 查询语句，只输出一条 SQL，不要任何解释。
表结构：
CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(50), city VARCHAR(50), created_at DATETIME);
CREATE TABLE products (id INT PRIMARY KEY, name VARCHAR(100), category VARCHAR(50), price DECIMAL(10,2), stock INT);
CREATE TABLE orders (id INT PRIMARY KEY, user_id INT, status VARCHAR(20), created_at DATETIME);
CREATE TABLE order_items (id INT ... (truncated)
SELECT o.id, o.status, SUM(p.amount) AS total_amount
FROM orders o
JOIN payments p ON o.id = p.order_id
WHERE o.id IN (
    SELECT order_id
    FROM payments
    GROUP BY order_id
    HAVING SUM(amount) > (SELECT AVG(amount) FROM payments)
)
